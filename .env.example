# ==========================================================================
#  统一模型调用网关 —— 密钥配置模板
# ==========================================================================
#  用法（超简单，三步）：
#    1) 把本文件复制一份，改名为   .env     （注意前面有个点，没有 .example）
#       命令：copy .env.example .env
#    2) 把你申请到的 Key 填在等号右边（只填有的，没有的整行留着不管）
#    3) 运行  python scripts/llm_gateway.py providers   看是否识别成功
#
#  ⚠️  安全说明
#    · .env 已经被 .gitignore 忽略，**永远不会被提交到 GitHub**，可以放心放 Key。
#    · 永远不要把 Key 直接写进 .py / .vue / .md 代码里。
#    · 换模型不需要改任何代码，只改这个文件。
#
#  容灾机制（网关自动生效，无需配置）
#    · 按下面「优先级」从上到下依次尝试：谁的 Key 有效就用谁。
#    · 某家 Key 失效（401）/ 欠费 / 模型未开通 → 自动跳到下一家，业务不中断。
#    · 某家限流（429）或网络抖动 → 自动退避重试，仍失败才切换。
#    · 一家都没配 → 全站 AI 功能自动降级（照常运行，只是没有 AI 增强）。
# ==========================================================================


# --------------------------------------------------------------------------
# 【优先级 1】通义千问 —— 阿里云百炼（推荐主力，中文强、便宜、国内直连）
#   申请：https://bailian.console.aliyun.com/  → API-KEY 管理 → 创建
#   文档：https://help.aliyun.com/zh/model-studio/get-api-key
#   模型：qwen-plus（推荐）/ qwen-turbo（最便宜）/ qwen-max（最强）
# --------------------------------------------------------------------------
DASHSCOPE_API_KEY=
# 单独指定这家的模型（不影响别家；不填则用默认 qwen-plus）
# QWEN_MODEL=qwen-plus


# --------------------------------------------------------------------------
# 【优先级 2】豆包 —— 火山方舟 Ark（字节，中文和视频理解强）
#   申请：https://console.volcengine.com/ark  → API Key 管理 → 创建
#   注意：模型必须在控制台「开通管理」里逐个开通，没开通会报 404
#   模型 ID 也可填推理接入点（ep- 开头）
# --------------------------------------------------------------------------
ARK_API_KEY=
# 若报 404 / 模型不存在：把下面取消注释，改成你控制台里「已开通」的模型名或接入点 ID
# DOUBAO_MODEL=doubao-seed-2-1-pro-260628


# --------------------------------------------------------------------------
# 【优先级 3】DeepSeek 深度求索（推理强、价格低；需充值，余额为 0 会返回 402）
#   申请：https://platform.deepseek.com/api_keys
# --------------------------------------------------------------------------
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat


# --------------------------------------------------------------------------
# 【优先级 4】智谱 GLM（当前站点一直在用的免费模型 glm-4-flash）
#   申请：https://open.bigmodel.cn/usercenter/apikeys
# --------------------------------------------------------------------------
ZHIPUAI_API_KEY=
# ZHIPU_MODEL=glm-4-flash


# --------------------------------------------------------------------------
# 【优先级 5】月之暗面 Kimi（长文本能力强）
#   申请：https://platform.moonshot.cn/console/api-keys
# --------------------------------------------------------------------------
MOONSHOT_API_KEY=


# --------------------------------------------------------------------------
# 【优先级 6】OpenAI 官方（国内直连不通，一般不用）
# --------------------------------------------------------------------------
OPENAI_API_KEY=


# --------------------------------------------------------------------------
# 【优先级 7】本地模型（Ollama / vLLM，完全免费、不需要 Key）
#   装好 Ollama 后执行：ollama pull qwen2.5:7b
#   想启用就取消下面那行注释（不取消则不进容灾链，避免白失败一次）
# --------------------------------------------------------------------------
# OLLAMA_BASE_URL=http://localhost:11434/v1


# --------------------------------------------------------------------------
# 【高级开关】一般不用改
# --------------------------------------------------------------------------
# 强制只用某一家（可用值：qwen doubao deepseek zhipu moonshot openai local）
# LLM_PROVIDER=qwen
# 自定义优先级顺序
# LLM_ORDER=deepseek,qwen,zhipu
# ⚠️ 全局模型覆盖：会让所有供应商都用这一个模型名，通常只在只用一家的场景下开
#    想让某一家单独换模型，请用上面的 QWEN_MODEL / DOUBAO_MODEL / DEEPSEEK_MODEL / ZHIPU_MODEL
# LLM_MODEL=qwen-plus
# 生成参数
# LLM_TEMPERATURE=0.3
# LLM_MAX_TOKENS=1500
# 网络超时（秒）
# LLM_TIMEOUT=90
# 单家失败重试次数
# LLM_RETRIES=2
# 是否允许失败后自动切换供应商（1 开 / 0 关）
# LLM_FALLBACK=1
# 是否记录用量日志到 logs/llm-calls.jsonl（1 开 / 0 关，不记录 Key）
# LLM_LOG=1
